{
  "alpha-telegram-sync": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 /home/agy/agy-server/server/hook_notify.py PreInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 /home/agy/agy-server/server/hook_notify.py Stop",
        "timeout": 10
      }
    ]
  },
  "alpha-telegram-approval": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file|read_url_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/agy/agy-server/server/hook_approve.py",
            "timeout": 130
          }
        ]
      }
    ]
  }
}
