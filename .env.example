# Copy to /home/agy/agy-server/.env on the server (chmod 600, never commit .env)
TELEGRAM_BOT_TOKEN=replace-me

# Comma-separated Telegram numeric user IDs allowed to control Alpha (recommended)
TELEGRAM_ALLOWED_USER_IDS=

# Optional: restrict to specific chat IDs (your DM user ID and/or private supergroup -100... ID)
TELEGRAM_ALLOWED_CHAT_IDS=

# Bridge behavior
DEFAULT_MIRROR_MODE=full
MAX_INLINE_CHARS=3500
SSH_PROMPT_PREVIEW_CHARS=300
DEBOUNCE_SECONDS=1.5
POLL_TIMEOUT_SECONDS=30

# Antigravity CLI settings
ALPHA_WORKSPACE=/home/agy/alpha-assistant
AGY_BIN=/home/agy/.local/bin/agy
# Optional model override (leave blank to use agy CLI default)
AGY_MODEL=
AGY_TIMEOUT_SECONDS=600
BRIDGE_TZ_LABEL=PST
