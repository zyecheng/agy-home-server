[Unit]
Description=Antigravity Home AI Server Telegram Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agy
WorkingDirectory=/home/agy/agy-server
Environment="PATH=/home/agy/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-/home/agy/agy-server/.env
ExecStart=/usr/bin/python3 -m server.bot
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
